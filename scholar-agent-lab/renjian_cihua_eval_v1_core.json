[
    {
        "id": 1,
        "text": "泪眼问花花不语，乱红飞过秋千去",
        "labels": {
            "type": "有我"
        },
        "source": "3"
    },
    {
        "id": 2,
        "text": "可堪孤馆闭春寒，杜鹃声里斜阳暮",
        "labels": {
            "type": "有我"
        },
        "source": "3"
    },
    {
        "id": 3,
        "text": "采菊东篱下，悠然见南山",
        "labels": {
            "type": "无我"
        },
        "source": "3"
    },
    {
        "id": 4,
        "text": "寒波澹澹起，白鸟悠悠下",
        "labels": {
            "type": "无我"
        },
        "source": "3"
    },
    {
        "id": 5,
        "text": "细雨鱼儿出，微风燕子斜",
        "labels": {
            "scale": "小"
        },
        "source": "8"
    },
    {
        "id": 6,
        "text": "落日照大旗，马鸣风萧萧",
        "labels": {
            "scale": "大"
        },
        "source": "8"
    },
    {
        "id": 7,
        "text": "宝帘闲挂小银钩",
        "labels": {
            "scale": "小"
        },
        "source": "8"
    },
    {
        "id": 8,
        "text": "雾失楼台，月迷津渡",
        "labels": {
            "scale": "大"
        },
        "source": "8"
    },
    {
        "id": 9,
        "text": "西风残照，汉家陵阙",
        "labels": {
            "气象": "有"
        },
        "source": "10"
    },
    {
        "id": 10,
        "text": "自是人生长恨水长东",
        "labels": {
            "气象": "有"
        },
        "source": "15"
    },
    {
        "id": 11,
        "text": "流水落花春去也，天上人间",
        "labels": {
            "气象": "有"
        },
        "source": "15"
    },    {
        "id": 12,
        "text": "风雨如晦，鸡鸣不已",
        "labels": {
            "气象": "有"
        },
        "source": "30"
    },
    {
        "id": 13,
        "text": "山峻高以蔽日兮，下幽晦以多雨。霰雪纷其无垠兮，云霏霏而承宇",
        "labels": {
            "气象": "有"
        },
        "source": "30"
    },
    {
        "id": 14,
        "text": "树树皆秋色，山山尽落晖",
        "labels": {
            "气象": "有"
        },
        "source": "30"
    },
    {
        "id": 15,
        "text": "可堪孤馆闭春寒，杜鹃声里斜阳暮",
        "labels": {
            "气象": "有"
        },
        "source": "30"
    },
    {
        "id": 16,
        "text": "二十四桥仍在，波心荡、冷月无声",
        "labels": {
            "ge_buge": "隔"
        },
        "source": "39"
    },
    {
        "id": 17,
        "text": "数峰清苦，商略黄昏雨",
        "labels": {
            "ge_buge": "隔"
        },
        "source": "39"
    },
    {
        "id": 18,
        "text": "高树晚蝉，说西风消息",
        "labels": {
            "ge_buge": "隔"
        },
        "source": "39"
    },
    {
        "id": 19,
        "text": "池塘生春草",
        "labels": {
            "ge_buge": "不隔"
        },
        "source": "40"
    },
    {
        "id": 20,
        "text": "空梁落燕泥",
        "labels": {
            "ge_buge": "不隔"
        },
        "source": "40"
    },
    {
        "id": 21,
        "text": "阑干十二独凭春，晴碧远连云，二月三月，千里万里，行色苦愁人。",
        "labels": {
            "ge_buge": "不隔"
        },
        "source": "40"
    },
    {
        "id": 22,
        "text": "谢家池上，江淹浦畔",
        "labels": {
            "ge_buge": "隔"
        },
        "source": "40"
    },
    {
        "id": 23,
        "text": "此地，宜有词仙，拥素云黄鹤，与君游戏。玉梯凝望久，叹芳草萋萋千里。",
        "labels": {
            "ge_buge": "不隔"
        },
        "source": "40"
    },
    {
        "id": 24,
        "text": "酒祓清愁，花消英气",
        "labels": {
            "ge_buge": "隔"
        },
        "source": "40"
    },
    {
        "id": 25,
        "text": "生年不满百，常怀千岁忧。昼短苦夜长，何不秉烛游。",
        "labels": {
            "ge_buge": "不隔"
        },
        "source": "41"
    },
    {
        "id": 26,
        "text": "食求神仙，多为药所误。不如饮美酒，被服纨与素。",
        "labels": {
            "ge_buge": "不隔"
        },
        "source": "41"
    },
    {
        "id": 27,
        "text": "采菊东篱下，悠然见南山。山气日夕佳，飞鸟相与还。",
        "labels": {
            "ge_buge": "不隔"
        },
        "source": "41"
    },
    {
        "id": 28,
        "text": "天似穹庐，笼盖四野。天苍苍，野茫茫，风吹草低见牛羊。",
        "labels": {
            "ge_buge": "不隔"
        },
        "source": "41"
    }
]