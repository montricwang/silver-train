      "type": "reality",
      "direction": "real→virtual_imagination",
      "note": "从眼前簪残花转入想象盛花之态"
    },
    {
      "between_lines": "L10-L11",
      "type": "time",
      "direction": "present→future",
      "note": "从眼前想象转入对未来落花漂流的担忧"
    },
    {
      "between_lines": "L10-L11",
      "type": "space",
      "direction": "近处（钗头）→远处（潮汐水上）",
      "note": "空间从近处跳至远方"
    }
  ],
  "summary": {
    "dominant_time_organization": "flashback",
