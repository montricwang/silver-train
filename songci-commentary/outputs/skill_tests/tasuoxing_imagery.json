      "involved_imagery": [
        "孤馆",
        "桃源"
      ],
      "note": "封闭现实与理想仙境形成强烈对比"
    },
    {
      "type": "progression",
      "involved_imagery": [
        "斜阳",
        "杜鹃声"
      ],
      "note": "从视觉到听觉，层层递进渲染暮色哀愁"
    },
    {
      "type": "juxtaposition",
      "involved_imagery": [
        "驿寄梅花",
        "鱼传尺素"
      ],
      "note": "两个相似动作并置，强调书信频繁"
    },
    {
      "type": "transformation",
      "involved_imagery": [
        "砌成此恨",
        "郴江"
      ],
      "note": "从抽象恨意转向具象江水，情感外化"
    },
    {
      "type": "contrast",
      "involved_imagery": [
        "郴江",
        "郴山"
      ],
      "note": "流动与静止、离去与留守的对照"
    }
  ],
