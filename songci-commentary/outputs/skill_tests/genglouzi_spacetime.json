{
  "poem_title": "更漏子·柳丝长",
  "line_analysis": [
    {
      "line_id": "L1",
      "text": "柳丝长，春雨细，花外漏声迢递。",
      "time": "present",
      "space": {
        "location": "室外（花外）",
        "distance": "near",
        "interior_exterior": "exterior"
      },
      "reality": "real",
      "note": "眼前实景，漏声从远处传来"
    },
    {
      "line_id": "L2",
      "text": "惊塞雁，起城乌，画屏金鹧鸪。",
      "time": "present",
      "space": {
        "location": "室外→室内（画屏）",
        "distance": "far→near",
        "interior_exterior": "exterior→interior"
      },
      "reality": "real",
      "note": "空间跳接：从塞雁城乌到室内画屏"
    },
    {
      "line_id": "L3",
      "text": "香雾薄，透帘幕，惆怅谢家池阁。",
      "time": "present",
      "space": {
        "location": "室内（帘幕、谢家池阁）",
        "distance": "near",
        "interior_exterior": "interior"
      },
      "reality": "real",
      "note": "实景，谢家池阁为室内或庭院"
    },
    {
      "line_id": "L4",
      "text": "红烛背，绣帘垂，梦长君不知。",
      "time": "present→dream",
      "space": {
        "location": "室内（红烛、绣帘）",
        "distance": "near",
        "interior_exterior": "interior"
      },
      "reality": "real→virtual_imagination",
      "note": "末句转入梦境想象，君不知为虚境"
    }
  ],
